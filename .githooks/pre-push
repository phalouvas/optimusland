#!/bin/bash
# Pre-push hook: run tests before allowing push to version-16
# Install: cp this file to .git/hooks/pre-push && chmod +x .git/hooks/pre-push

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Only enforce tests when pushing to version-16 or main
if [ "$BRANCH" = "version-16" ] || [ "$BRANCH" = "main" ]; then
    echo "🚀 Running tests before push to $BRANCH..."
    
    cd /workspace/development/v16
    
    bench run-tests --app optimusland 2>&1
    
    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ TESTS FAILED — push rejected."
        echo "   Fix the failing tests before pushing."
        exit 1
    fi
    
    echo "✅ All tests passed — push allowed."
fi

exit 0
