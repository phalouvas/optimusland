#!/bin/bash
# Pre-push hook: run tests before allowing any push

cd /workspace/development/v16

LOG_FILE=/tmp/optimusland-test-output.log

bench run-tests --app optimusland > "$LOG_FILE" 2>&1
RESULT=$?

echo ""
echo "=================================================="
echo "  optimusland tests"
echo "=================================================="
if [ $RESULT -ne 0 ]; then
    echo "  STATUS: FAILED ($RESULT failure(s)) - push rejected"
    echo "  LOG: $LOG_FILE"
    echo "  To see details: cat $LOG_FILE"
    echo "  Or run: bench run-tests --app optimusland"
    echo "=================================================="
    echo ""
    exit 1
fi
echo "  STATUS: PASSED (107 tests) - push allowed"
echo "=================================================="
echo ""
exit 0
