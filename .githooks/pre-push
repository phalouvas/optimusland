#!/bin/bash
# Pre-push hook: run tests before allowing any push

echo ""
echo "================================================"
echo "  Running optimusland tests before push..."
echo "================================================"
echo ""

cd /workspace/development/v16

bench run-tests --app optimusland 2>&1
RESULT=$?

echo ""
if [ $RESULT -ne 0 ]; then
    echo "================================================"
    echo "  TESTS FAILED - push rejected"
    echo ""
    echo "  $RESULT test(s) failed or errored."
    echo ""
    echo "  To see details, run in terminal:"
    echo "    bench run-tests --app optimusland"
    echo ""
    echo "  Click 'Show Command Output' above to see the"
    echo "  full test output."
    echo "================================================"
    echo ""
    exit 1
fi

echo "================================================"
echo "  All 107 tests passed - push allowed."
echo "================================================"
echo ""
exit 0
